{
  "name": "arsonist-timer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "app": "npm run build && electron .",
    "app:open": "electron .",
    "package:local": "npm run build && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-local-app.ps1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.3.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "electron": "^41.3.0",
    "postcss": "^8.5.6",
    "rcedit": "^5.0.2",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "local.arsonisttimer.desktop",
    "productName": "ArsonistTimer",
    "icon": "electron/assets/arsonisttimer-clock.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    }
  }
}
